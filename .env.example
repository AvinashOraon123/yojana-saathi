# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=your_sarvam_api_key_here

# Force bundled sample data and no Sarvam calls (also automatic when no key is set)
DEMO_MODE=0

# Chat model used for extraction, intent slots, answers and the self-check pass
SARVAM_CHAT_MODEL=sarvam-105b
# low | high | max  (low is fastest)
SARVAM_REASONING_EFFORT=low

# Optional: price per 1K chat tokens (INR) so per-request cost can be logged. 0 = log tokens only.
COST_PER_1K_TOKENS=0

# Start the background crawler (daily) and deadline re-verifier (every 6h) inside the API process
ENABLE_SCHEDULER=0

# Per-IP rate limit (requests per minute)
RATE_LIMIT_PER_MIN=30

# Extra model call that rewrites each answer to remove unsupported claims (adds ~10 s). Code-level check always runs.
VERIFY_WITH_LLM=0
